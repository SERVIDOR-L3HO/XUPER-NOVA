<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20.0px" />
            <gradient android:startColor="#ff2b194f" android:endColor="#ff075c6a" android:angle="0.0" />
            <stroke android:width="2.0px" android:color="#ff8b72ff" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20.0px" />
            <gradient android:startColor="#ff40216d" android:endColor="#ff087b88" android:angle="0.0" />
            <stroke android:width="2.0px" android:color="#ff6de4e7" />
        </shape>
    </item>
</selector>
